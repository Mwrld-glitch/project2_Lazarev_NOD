[0.019222, "o", "\u001b[?2004h\u001b]0;admin@Ubuntu: ~/project2_Lazarev_NOD\u0007\u001b[01;32madmin@Ubuntu\u001b[00m:\u001b[01;34m~/project2_Lazarev_NOD\u001b[00m$ "]
[3.471378, "o", "\u001b[7mmake database\u001b[27m"]
[4.12921, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\bmake database\r\n\u001b[?2004l\r"]
[4.13276, "o", "poetry run database\r\n"]
[4.54531, "o", "\r\n***Операции с данными***\r\nФункции:\r\n<command> insert into <таблица> values (<значения>) - создать запись\r\n<command> select from <имя_таблицы> - прочитать все записи\r\n<command> select from <таблица> [where условие] - прочитать записи\r\n<command> update <таблица> set <столбец>=<значение> where <условие> -обновить запись\r\n<command> delete from <таблица> where <условие> - удалить запись\r\n<command> info <таблица> - информация о таблице\r\n<command> create_table <таблица> <столбцы> - создать таблицу\r\n<command> list_tables - список таблиц\r\n<command> drop_table <таблица> - удалить таблицу\r\n<command> exit - выход\r\n<command> help - справка\r\n\r\nВведите команду: "]
[9.748607, "o", "create_table users name:str age:int is_active:bool"]
[10.302605, "o", "\r\n"]
[10.3028, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[10.303059, "o", "Введите команду: "]
[13.704939, "o", "insert into users values (\"Sergei\", 28 true)"]
[14.499575, "o", "\r\n"]
[14.500324, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n"]
[14.500779, "o", "Введите команду: "]
[18.338893, "o", "insert into users values (\"Anna\", 25 false) "]
[18.941386, "o", "\r\n"]
[18.943095, "o", "Запись с ID=2 успешно добавлена в таблицу \"users\".\r\n"]
[18.943275, "o", "Введите команду: "]
[21.995061, "o", "insert into users values (\"Alex\", 30 true)"]
[22.567523, "o", "\r\n"]
[22.568145, "o", "Запись с ID=3 успешно добавлена в таблицу \"users\".\r\n"]
[22.568583, "o", "Введите команду: "]
[25.952775, "o", "select from users"]
[26.595468, "o", "\r\n"]
[26.598551, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n| 2  |  Anna  |  25 |   False   |\r\n| 3  |  Alex  |  30 |    True   |\r\n+----+--------+-----+-----------+\r\nВведите команду: "]
[30.164935, "o", "select from users where age = 30"]
[30.733539, "o", "\r\n"]
[30.734032, "o", "+----+------+-----+-----------+\r\n| ID | name | age | is_active |\r\n+----+------+-----+-----------+\r\n| 3  | Alex |  30 |    True   |\r\n+----+------+-----+-----------+\r\nВведите команду: "]
[33.997915, "o", "select from users where is_active = True"]
[34.636773, "o", "\r\n"]
[34.637363, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n| 3  |  Alex  |  30 |    True   |\r\n+----+--------+-----+-----------+\r\nВведите команду: "]
[38.686274, "o", "update users set age = 29 where name = \"Sergei\""]
[39.271048, "o", "\r\n"]
[39.271641, "o", "Запись успешно обновлена\r\nВведите команду: "]
[42.691601, "o", "delete from users where name = \"Alex\""]
[43.533323, "o", "\r\n"]
[43.533891, "o", "Удалено записей: 1\r\nВведите команду: "]
[47.181785, "o", "select from users"]
[47.956068, "o", "\r\n"]
[47.956604, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n| 2  |  Anna  |  25 |   False   |\r\n+----+--------+-----+-----------+\r\nВведите команду: "]
[54.16736, "o", "info users"]
[54.803623, "o", "\r\n"]
[54.803938, "o", "Таблица: users\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\nКоличество записей: 2\r\nВведите команду: "]
[60.822627, "o", "list_tables"]
[61.371753, "o", "\r\n"]
